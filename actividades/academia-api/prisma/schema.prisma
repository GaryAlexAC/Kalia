generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Nivel {
  EXPLORADORES // 10-12 años
  CONSTRUCTORES // 13-15 años
  AVANZADOS // 16-18 años
}

enum Materia {
  MATEMATICAS
  LECTURA
  CIENCIAS
}

model Estudiante {
  id        Int                  @id @default(autoincrement())
  nombre    String
  email     String?              @unique
  nivel     Nivel                @default(EXPLORADORES)
  xpTotal   Int                  @default(0)
  creadoEn  DateTime             @default(now())
  progresos Progreso[]
  insignias EstudianteInsignia[]
}

model Actividad {
  id        Int        @id @default(autoincrement())
  slug      String     @unique // ej. "matematicas/01-construye-tu-pizza"
  titulo    String
  materia   Materia
  progresos Progreso[]
}

model Progreso {
  id           Int        @id @default(autoincrement())
  estudianteId Int
  actividadId  Int
  nivel        Nivel
  xp           Int
  completadoEn DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  actividad    Actividad  @relation(fields: [actividadId], references: [id])

  @@index([estudianteId])
}

// Catálogo de insignias. Se ganan al acumular XP:
// materia = null  -> con el XP total del estudiante
// materia = X     -> con el XP acumulado solo en esa materia
model Insignia {
  id          Int                  @id @default(autoincrement())
  codigo      String               @unique // ej. "primeros-pasos"
  nombre      String
  descripcion String
  materia     Materia?
  xpRequerido Int
  estudiantes EstudianteInsignia[]
}

// Insignias que ya tiene cada estudiante
model EstudianteInsignia {
  estudianteId Int
  insigniaId   Int
  obtenidaEn   DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  insignia     Insignia   @relation(fields: [insigniaId], references: [id], onDelete: Cascade)

  @@id([estudianteId, insigniaId])
}
